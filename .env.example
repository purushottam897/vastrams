# Gmail SMTP Credentials (Use a 16-character Google App Password, NO spaces)
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Comma-separated list of recipient emails
REPORT_TO=youraddress@gmail.com,partner@example.com

# Database Connection:
# For Vastrams MongoDB Atlas / local MongoDB:
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vastrams
# Optional fallback if using a local SQLite DB instead of MongoDB:
DB_PATH=

# Optional CSV attachment of today's transactions (true/false)
ATTACH_CSV=true
